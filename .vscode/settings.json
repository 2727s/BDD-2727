{
  "files.exclude": {
    "**/__pycache__": true
  },
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "features/**/*.py",
    "test_login.py"
  ],
  "cucumberautocomplete.steps": [
    "features/steps/*.py",
    "test_*.py"
  ],
  "cucumberautocomplete.syncfeatures": "features/*.feature",
  "cucumberautocomplete.customParameters": [
    {
      "parameter": "{string}",
      "value": "(\"[^\"]*\"|'[^']*')"
    },
    {
      "parameter": "{int}",
      "value": "-?\\d+"
    },
    {
      "parameter": "{float}",
      "value": "-?\\d+\\.\\d+"
    },
    {
      "parameter": "{word}",
      "value": "[A-Za-z0-9_]+"
    }
  ]
}
